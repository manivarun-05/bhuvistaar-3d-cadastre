# ==============================================================================
# BhuVistaar — 3D Cadastral Intelligence & Validation Platform
# Production & Local Environment Configuration Template (.env.example)
#
# NOTE: Never commit sensitive credentials or secret keys to version control.
# Copy this file to `.env` for local development.
# On Render, configure these variables in the Service Dashboard or render.yaml.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Render Static Site / Client-side)
# Exposed to browser code via Vite build. Must NOT contain private backend secrets.
# ------------------------------------------------------------------------------
# In production, set to your Render backend URL (e.g., https://bhuvistaar-backend.onrender.com)
# In local development, leave empty to proxy automatically to http://127.0.0.1:8000
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND PRIVATE CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
# Operational environment: production, development, demo, test
APP_ENV=production

# Listening port & host (Render automatically injects PORT=10000 at runtime)
PORT=8000
HOST=0.0.0.0

# CORS origins: Comma-separated list of allowed origins.
# Render subdomains (*.onrender.com) and localhost are automatically authorized.
CORS_ORIGINS=https://bhuvistaar-frontend.onrender.com,http://localhost:5173

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Base URLs for inter-service communication
API_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=https://bhuvistaar-frontend.onrender.com

# ------------------------------------------------------------------------------
# 3. DATABASE PERSISTENCE CONFIGURATION
# ------------------------------------------------------------------------------
# Authoritative PostGIS connection URI.
# Render Managed Postgres format: postgresql+psycopg://user:password@hostname:5432/dbname
# If DATABASE_URL is not set or PostgreSQL is unreachable, BhuVistaar automatically
# boots its built-in SQLite PostGIS emulation layer with zero configuration.
DATABASE_URL=postgresql+psycopg://postgres:postgrespassword@127.0.0.1:5432/bhuvistaar_cadastre

# Canonical projected coordinate system (UTM Zone 43N default for Western/Central India)
CANONICAL_STORAGE_SRID=32643
CANONICAL_STORAGE_CRS=EPSG:32643

# ------------------------------------------------------------------------------
# 4. AUTHORIZATION & SECURITY
# ------------------------------------------------------------------------------
# Authorization mode banner (SIMULATED_PROTOTYPE or PRODUCTION_STRICT)
AUTHORIZATION_MODE=SIMULATED_PROTOTYPE
MAX_UPLOAD_SIZE_BYTES=10485760

# ------------------------------------------------------------------------------
# 5. AI INTELLIGENCE LAYER
# ------------------------------------------------------------------------------
# AI operational mode: LOCAL (deterministic heuristic/geometry inference), DETERMINISTIC, DISABLED
AI_MODE=LOCAL
AI_ASSISTANCE_ENABLED=true
AI_CONFIDENCE_THRESHOLD_HIGH=0.85
AI_CONFIDENCE_THRESHOLD_MEDIUM=0.60

# ------------------------------------------------------------------------------
# 6. CADASTRAL VALIDATION ENGINE TOLERANCES
# ------------------------------------------------------------------------------
ADJACENCY_TOLERANCE_M=0.001
OVERLAP_THRESHOLD_M=0.001
PLANAR_CONTAINMENT_TOLERANCE_M=0.001
COORDINATE_PRECISION_DECIMALS=3
STALE_THRESHOLD_SECONDS=3600
RULESET_VERSION=1.0.0
VALIDATOR_VERSION=1.0.0
DEMO_MODE=true
